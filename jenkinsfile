pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/student-niranjan/pipeline.git',
                    credentialsId: 'github-token'
            }
        }

        stage('Build') {
            steps {
                echo "Building website..."
            }
        }

        stage('Deploy') {
            steps {
                echo "Deploying website..."

                // Copy files to deployment folder
                bat '''
                    xcopy /E /Y * C:\\deploy-folder\\
                '''

                // Generate link in console
                echo "--------------------------------------------"
                echo "Website deployed successfully!"
                echo "Click here to open your site:"
                echo "file:///C:/deploy-folder/index.html"
                echo "--------------------------------------------"
            }
        }
    }

    triggers {
        githubPush()
    }
}

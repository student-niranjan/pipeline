pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/student-niranjan/pipeline.git',
                    credentialsId: 'github-token'
            }
        }

        stage('Build') {
            steps {
                echo "Building website..."
            }
        }

        stage('Deploy') {
            steps {
                echo "Deploying website..."

                // Copy files to deployment folder
                bat '''
                    xcopy /E /Y * C:\\deploy-folder\\
                '''

                // Open Chrome (Windows)
                bat '''
                    rem Open website in Chrome
                    start chrome "C:\\deploy-folder\\index.html"
                '''
            }
        }
    }

    triggers {
        githubPush()
    }
}

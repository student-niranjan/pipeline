pipeline {
    agent any

    environment {
        // -------------------------------
        // CHANGE THIS: IIS deployment folder
        // Ensure IIS is running and Jenkins has permission to write here
        DEPLOY_DIR = "C:\\inetpub\\wwwroot\\practical1"

        // -------------------------------
        // CHANGE THIS: Local source folder (your OneDrive folder with files)
        // Must include quotes due to spaces in path
        SOURCE_DIR = "C:\\Users\\Niranjan\\OneDrive\\Documents\\New folder"

        // -------------------------------
        // CHANGE THIS: GitHub repository URL (optional if using Git)
        GIT_REPO = "https://github.com/student-niranjan/pipeline.git"

        // -------------------------------
        // OPTIONAL: Git credentials ID configured in Jenkins
        GIT_CREDENTIALS = "github-jenkins"
    }

    stages {
        stage('Checkout SCM (Optional)') {
            steps {
                echo "Cloning project from GitHub..."
                // Remove this stage if you are not using Git
                git branch: 'main',
                    url: "${GIT_REPO}",
                    credentialsId: "${GIT_CREDENTIALS}"
            }
        }

        stage('Build') {
            steps {
                echo "Static portfolio site – no build step needed."
            }
        }

        stage('Deploy') {
            steps {
                echo "Deploying portfolio files from '${SOURCE_DIR}' to IIS folder: ${DEPLOY_DIR}"

                // Create folder if it doesn't exist
                bat "if not exist \"${DEPLOY_DIR}\" mkdir \"${DEPLOY_DIR}\""

                // Copy HTML and CSS files
                bat "xcopy /Y /I \"${SOURCE_DIR}\\index.html\" \"${DEPLOY_DIR}\\\""
                bat "xcopy /Y /I \"${SOURCE_DIR}\\about.html\" \"${DEPLOY_DIR}\\\""
                bat "xcopy /Y /I \"${SOURCE_DIR}\\style.css\" \"${DEPLOY_DIR}\\\""

                // Copy assets folder if it exists
                bat "if exist \"${SOURCE_DIR}\\assets\" xcopy /Y /I /E \"${SOURCE_DIR}\\assets\" \"${DEPLOY_DIR}\\assets\\\""
            }
        }

        stage('Run HTTP Server') {
            steps {
                echo "IIS will serve the website. No extra server is started by Jenkins."
            }
        }

        stage('Post Actions') {
            steps {
                echo "✅ Pipeline finished successfully!"
                // -------------------------------
                // Browser link (matches IIS folder)
                echo "👉 About Me page: http://localhost/New/index.html"
            }
        }
    }
}

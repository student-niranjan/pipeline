pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/student-niranjan/pipeline.git',
                    credentialsId: 'github-token'
            }
        }

        stage('Build') {
            steps {
                echo "Building website..."
            }
        }

        stage('Deploy') {
            steps {
                echo "Deploying website..."

                // Copy website files to deploy folder
                bat '''
                    if not exist C:\\deploy-folder mkdir C:\\deploy-folder
                    xcopy /E /I /Y * C:\\deploy-folder\\
                '''

                echo "Files deployed to C:\\deploy-folder"
            }
        }

        stage('Start Local Web Server') {
            steps {
                echo "Starting local server on http://localhost:9090"

                // Start local Python HTTP server
                bat '''
                    powershell -Command "Start-Process powershell -ArgumentList '-NoExit','-Command','cd C:\\deploy-folder; python -m http.server 9090'"
                '''

                // Print clickable link
                echo "---------------------------------------------"
                echo " WEBSITE DEPLOYED SUCCESSFULLY! "
                echo ""
                echo " Open your site in browser:"
                echo " ▶ ▶ http://localhost:9090"
                echo ""
                echo "---------------------------------------------"
            }
        }
    }

    triggers {
        githubPush()
    }
}
